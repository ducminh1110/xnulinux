+/*
+ * A C function the JIT'ed code calls (the fallback fetch of a format with no JIT'ed one): declared by name in the module and bound
+ * to its address when the module is linked (gallivm_add_global_mapping), instead of an address baked into the code. The object
+ * code of such a shader can then be cached on disk and linked again in another process (the address changes with every run).
+ */
+static LLVMValueRef
+lp_build_named_c_function(struct gallivm_state *gallivm, const char *prefix, const char *format_name,
+                          LLVMTypeRef function_type, void *addr)
+{
+   char name[160];
+   snprintf(name, sizeof name, "%s_%s", prefix, format_name);
+   LLVMValueRef fn = LLVMGetNamedFunction(gallivm->module, name);
+   if (!fn) {
+      fn = LLVMAddFunction(gallivm->module, name, function_type);
+      gallivm_add_global_mapping(gallivm, fn, addr);
+   }
+   return fn;
+}
